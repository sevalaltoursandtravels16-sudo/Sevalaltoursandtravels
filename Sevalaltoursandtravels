<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sevalal Tours & Travels</title>
<style>
body{margin:0;font-family:Arial;background:#f3f7fb;color:#123}
header{background:#06345c;color:white;padding:20px;text-align:center}
header h1{margin:0;color:#ffd21c}
.hero{background:#0b659b;color:white;padding:35px 20px;text-align:center}
.card{background:white;margin:20px auto;padding:20px;max-width:500px;border-radius:15px;box-shadow:0 3px 15px #bbb}
h2{color:#063f70}
input{width:100%;padding:13px;margin:7px 0;border:1px solid #ccc;border-radius:7px;box-sizing:border-box}
button,a{display:block;width:100%;padding:14px;margin-top:12px;border:0;border-radius:8px;text-align:center;text-decoration:none;font-weight:bold;box-sizing:border-box}
.book{background:#0877df;color:white}
.whatsapp{background:#20c967;color:white}
.phone{background:#222;color:white}
.pay{background:#ffd21c;color:#111}
footer{background:#06345c;color:white;text-align:center;padding:25px;margin-top:30px}
</style>
</head>

<body>

<header>
<h1>SEVALAL TOURS & TRAVELS</h1>
<p>Car Booking Service</p>
</header>

<div class="hero">
<h1>Book Your Ride</h1>
<p>Comfortable • Safe • Affordable</p>
</div>

<div class="card">
<h2>🚗 Suzuki Ertiga</h2>
<p>7 Seater • Comfortable Ride</p>
<p><b>👨‍✈️ Owner:</b> Sagar</p>
<p><b>📞 Phone:</b> +91 63618 88130</p>

<button class="book" onclick="document.getElementById('booking').scrollIntoView()">
BOOK NOW
</button>
</div>

<div class="card" id="booking">
<h2>📝 Booking Details</h2>

<input id="name" placeholder="Your Name">
<input id="mobile" placeholder="Mobile Number">
<input id="pickup" placeholder="Pickup Location">
<input id="drop" placeholder="Drop Location">
<input id="date" type="date">
<input id="time" type="time">
<input id="passengers" placeholder="Number of Passengers">

<button class="whatsapp" onclick="bookWhatsApp()">
🟢 BOOK DIRECT ON WHATSAPP
</button>
</div>

<div class="card">
<h2>💳 Payment</h2>
<p>Payment directly to Owner</p>
<p><b>PhonePe: 6361888130</b></p>

<a class="pay" href="tel:6361888130">
💳 PHONEPE: 6361888130
</a>

<a class="phone" href="tel:+916361888130">
📞 CALL SAGAR
</a>
</div>

<div class="card">
<h2>📧 Contact</h2>
<p>sevalaltoursandtravels16@gmail.com</p>
</div>

<footer>
© 2026 SEVALAL TOURS & TRAVELS
</footer>

<script>
function bookWhatsApp(){

let name=document.getElementById("name").value;
let mobile=document.getElementById("mobile").value;
let pickup=document.getElementById("pickup").value;
let drop=document.getElementById("drop").value;
let date=document.getElementById("date").value;
let time=document.getElementById("time").value;
let passengers=document.getElementById("passengers").value;

let message =
"Hello Sagar, I want to book Suzuki Ertiga.%0A%0A"+
"Name: "+name+"%0A"+
"Mobile: "+mobile+"%0A"+
"Pickup: "+pickup+"%0A"+
"Drop: "+drop+"%0A"+
"Date: "+date+"%0A"+
"Time: "+time+"%0A"+
"Passengers: "+passengers+"%0A%0A"+
"Payment: PhonePe 6361888130";

window.open(
"https://wa.me/916361888130?text="+message,
"_blank"
);
}
</script>

</body>
</html>
